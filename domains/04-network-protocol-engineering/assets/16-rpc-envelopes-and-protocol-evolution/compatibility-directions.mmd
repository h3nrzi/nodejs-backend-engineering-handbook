  subgraph B["New data into old reader"]
    B1["New writer"] --> B2["Old reader: unknown fields/values?"]
  end
  subgraph C["Read and rewrite path"]
    C1["Writer"] --> C2["Intermediary: preserve meaning?"]
    C2 --> C3["Reader: retained fields + meaning?"]
  end
  A2 ~~~ B1
