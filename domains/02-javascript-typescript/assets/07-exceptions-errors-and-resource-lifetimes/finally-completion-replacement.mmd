flowchart TB
  accTitle: Cleanup can preserve or replace a pending outcome
  accDescr: A pending return or throw enters finally. Normal finally completion preserves it; a return or throw from finally replaces it.
  P["Pending return or throw
from try / catch"] --> F{"finally completes
normally?"}
  F -->|Yes| K["Preserve pending outcome"]
  F -->|No: abrupt exit| R["Replace pending outcome
with finally outcome"]
  class K success;
  class R failure;

  classDef control fill:#F5F3FF,stroke:#7C3AED,color:#111827;
  classDef neutral fill:#F3F4F6,stroke:#4B5563,color:#111827;
  classDef success fill:#DCFCE7,stroke:#15803D,color:#111827;
  classDef pending fill:#FFFBEB,stroke:#B45309,color:#111827;
  classDef failure fill:#FEE2E2,stroke:#B91C1C,color:#111827;
